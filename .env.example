# Required: Your Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Model configuration
CHAT_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004

# Optional: Chunking parameters
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=5

# Optional: HTTPS proxy URL for YouTube transcripts only (Render/cloud IPs are often blocked by YouTube)
# YOUTUBE_TRANSCRIPT_PROXY=https://user:pass@host:port

# Optional: Per-IP rate limits (slowapi syntax: "<count>/<period>", e.g. "30/minute", "5/second")
RATE_LIMIT_CHAT=5/minute
RATE_LIMIT_QUIZ=2/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_INGEST=15/minute
